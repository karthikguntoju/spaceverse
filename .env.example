# Environment Variables for Spaceverse
#
# Copy to `.env` for local development. `.env` is gitignored; THIS file is not,
# so it must never hold a real credential — a working Atlas password lived here
# and went public with the repo.

# ── Database ───────────────────────────────────────────────────────────
# Local:
# MONGODB_URI=mongodb://localhost:27017/spaceverse
# Atlas:
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/spaceverse?retryWrites=true&w=majority

# ── Sessions ───────────────────────────────────────────────────────────
# Required when NODE_ENV=production; the server refuses to boot without it.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change_me_to_a_long_random_string

# ── Runtime ────────────────────────────────────────────────────────────
# Leave PORT unset on a managed host — it injects its own.
PORT=5000
# NODE_ENV=production also turns on trust-proxy and secure cookies.
# NODE_ENV=production

# Demo mode accepts any callsign/access code and writes nothing to the
# database. Set to false for the real Firebase + MongoDB account flow.
DEMO_AUTH=true

# ── Third party (optional) ─────────────────────────────────────────────
# NASA endpoints fall back to DEMO_KEY when this is unset.
NASA_API_KEY=your_nasa_api_key_here
# Without a valid key the quiz uses its curated question bank and the
# assistant answers from the built-in offline corpus. Whitespace is trimmed.
GEMINI_API_KEY=your_gemini_api_key_here

# ── CORS ───────────────────────────────────────────────────────────────
# Comma-separated origins allowed to make credentialed API calls. The app is
# same-origin, so this only matters if you call the API from another host.
# CORS_ORIGINS=http://localhost:5000,https://your-deploy.example

# ── Firebase (only when DEMO_AUTH=false) ──────────────────────────────
# Web config is not secret, but it is deployment-specific.
# FIREBASE_API_KEY=
# FIREBASE_AUTH_DOMAIN=
# FIREBASE_PROJECT_ID=
# FIREBASE_STORAGE_BUCKET=
# FIREBASE_MESSAGING_SENDER_ID=
# FIREBASE_APP_ID=
